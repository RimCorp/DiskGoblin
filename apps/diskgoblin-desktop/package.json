{
  "name": "diskgoblin-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "tauri": "tauri",
    "ui": "npm run build && cargo run --manifest-path ../../Cargo.toml -p diskgoblin-cli --bin diskgoblin -- --ui",
    "package:macos": "bash scripts/package-macos-app.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
